{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"noUncheckedIndexedAccess": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"types": ["vitest/globals", "node"],
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules"]
}
